  <vhdl name="unidad_control">-- ══════════════════════════════════════════════════════════════════
-- Problema:
-- Se requiere integrar las banderas de estado provenientes del modulo 
-- FLAGS (unificadas en un solo bus de 8 bits llamado FLGS) dentro del 
-- codigo VHDL de la Unidad de Control. 
--
-- Fundamentos Teóricos:
-- 1. Bus Unificado: En lugar de recibir pines individuales para Zero 
--    (FZ), Signo (FS) y Acarreo (FC), la FSM ahora lee un vector de 
--    8 bits, lo cual coincide con la arquitectura esquematica fisica.
-- 2. Alias: En VHDL, se pueden declarar "alias" para darle un nombre 
--    significativo a un bit o segmento especifico de un vector. Esto 
--    evita modificar toda la logica de control condicional existente 
--    (como los saltos), ya que el alias mapea el nombre anterior 
--    al nuevo indice dentro del bus.
--
-- Desglose Paso a Paso:
-- 1. En la entidad `unidad_control`, reemplazar los puertos de entrada
--    `FZ`, `FC` y `FS` por un unico puerto vectorial `FLGS` de 8 bits.
-- 2. En la seccion declarativa de la arquitectura, definir alias 
--    para FZ apuntando a `FLGS(0)`, FC a `FLGS(1)` y FS a `FLGS(2)` 
--    (basado en el diseno del multiplexor/splitter de la ALU).
-- 3. Mantener el bloque de codigo ejecutable identico, ya que los 
--    alias se encargaran de resolver las variables durante la sintesis.
-- ══════════════════════════════════════════════════════════════════

-- ══════════════════════════════════════════════════════════════════
-- Librerias / Dependencias
-- ══════════════════════════════════════════════════════════════════
LIBRARY IEEE;
USE IEEE.STD_LOGIC_1164.ALL;
USE IEEE.NUMERIC_STD.ALL;

-- ══════════════════════════════════════════════════════════════════
-- Entidad / Arquitectura
-- ══════════════════════════════════════════════════════════════════
ENTITY unidad_control IS
    PORT (
        -- Senales globales
        clk       : IN  STD_LOGIC;
        rst       : IN  STD_LOGIC;  -- rst general
        
        -- Entradas de estado desde la Ruta de Datos
        CO        : IN  STD_LOGIC_VECTOR(7 DOWNTO 0); -- Codigo de Operacion (OpCode) desde RI
        
        -- INTEGRACION: Bus unificado de banderas desde el registro FLAGS
        FLGS      : IN  STD_LOGIC_VECTOR(7 DOWNTO 0); 

        -- Salidas de Control hacia la Ruta de Datos
        clear     : OUT STD_LOGIC; -- Limpia PC, Registros, Flags
        Lpc       : OUT STD_LOGIC; -- Load PC
        Ipc       : OUT STD_LOGIC; -- Increment PC
        SelDir    : OUT STD_LOGIC; -- Selector del MUX de direcciones
        LH        : OUT STD_LOGIC; -- Load Registro H
        LL        : OUT STD_LOGIC; -- Load Registro L
        Lri       : OUT STD_LOGIC; -- Load Registro de Instruccion
        SelRegW   : OUT STD_LOGIC_VECTOR(2 DOWNTO 0); -- Seleccion Reg Escritura
        wr        : OUT STD_LOGIC; -- Write Enable del Banco de Registros
        SelRegRA  : OUT STD_LOGIC_VECTOR(2 DOWNTO 0); -- Seleccion Reg A
        SelRegRB  : OUT STD_LOGIC_VECTOR(2 DOWNTO 0); -- Seleccion Reg B
        ope       : OUT STD_LOGIC_VECTOR(2 DOWNTO 0); -- Codigo operacion ALU
        SalAlu    : OUT STD_LOGIC; -- Habilita buffer triestado de la ALU
        LF        : OUT STD_LOGIC; -- Load Flags
        
        -- Salidas de Control hacia la Memoria (Adaptado a Logisim de 8 bits)
        oe        : OUT STD_LOGIC; -- Output Enable (Activo Alto - Lectura)
        we        : OUT STD_LOGIC; -- Write Enable (Activo Alto - Escritura)
        
        -- Salida de Estado
        Fin       : OUT STD_LOGIC;  -- Indicador de fin de programa

        -- NUEVO: Salida para visualizar el estado de la FSM en Logisim
        estado_out: OUT STD_LOGIC_VECTOR(4 DOWNTO 0)
    );
END unidad_control;

ARCHITECTURE Behavioral OF unidad_control IS

    -- ══════════════════════════════════════════════════════════════════
    -- Lista de Definiciones y Alias
    -- ══════════════════════════════════════════════════════════════════
    
    -- INTEGRACION: Alias para mapear las banderas al bus FLGS
    ALIAS FZ : STD_LOGIC IS FLGS(0); -- Bandera Zero mapeada al bit 0
    ALIAS FC : STD_LOGIC IS FLGS(1); -- Bandera Carry mapeada al bit 1
    ALIAS FS : STD_LOGIC IS FLGS(2); -- Bandera Sign mapeada al bit 2

    TYPE estado_t IS (
        S00_RESET,
        S01_FETCH0, S02_FETCH1,
        S03_LOAD0_STORE0, S04_LOAD1_STORE1, S05_LOAD2_STORE2, S06_LOAD3_STORE3, 
        S07_LOAD4,
        S08_STORE5,
        S09_ADD0,
        S10_MOV0,
        S11_FIN0,
        S12_MOVI0, S13_MOVI1,
        S14_JMP_COND,
        S15_NOT0,
        S16_AND0,
        S17_DEC0,
        S18_INC0,
        S19_SUB0
    );

    SIGNAL estado_actual, estado_siguiente : estado_t;

BEGIN
    -- Mapeo del estado actual a una salida binaria para Sondas en Logisim
    WITH estado_actual SELECT
        estado_out &lt;= "00000" WHEN S00_RESET,
                      "00001" WHEN S01_FETCH0,
                      "00010" WHEN S02_FETCH1,
                      "00011" WHEN S03_LOAD0_STORE0,
                      "00100" WHEN S04_LOAD1_STORE1,
                      "00101" WHEN S05_LOAD2_STORE2,
                      "00110" WHEN S06_LOAD3_STORE3,
                      "00111" WHEN S07_LOAD4,
                      "01000" WHEN S08_STORE5,
                      "01001" WHEN S09_ADD0,
                      "01010" WHEN S10_MOV0,
                      "01011" WHEN S11_FIN0,
                      "01100" WHEN S12_MOVI0,
                      "01101" WHEN S13_MOVI1,
                      "01110" WHEN S14_JMP_COND,
                      "01111" WHEN S15_NOT0,
                      "10000" WHEN S16_AND0,
                      "10001" WHEN S17_DEC0,
                      "10010" WHEN S18_INC0,
                      "10011" WHEN S19_SUB0,
                      "11111" WHEN OTHERS;

    -- ══════════════════════════════════════════════════════════════════
    -- Codigo Ejecutable / Main
    -- ══════════════════════════════════════════════════════════════════

    -- Proceso Secuencial: Transicion de Estados
    PROCESS(clk, rst)
    BEGIN
        IF rst = '1' THEN
            estado_actual &lt;= S00_RESET;
        ELSIF rising_edge(clk) THEN
            estado_actual &lt;= estado_siguiente;
        END IF;
    END PROCESS;

    -- Proceso Combinacional: Logica de proximo estado y de salidas
    -- INTEGRACION: Eliminamos FZ, FC, FS de la lista sensitiva y agregamos FLGS
    PROCESS(estado_actual, CO, FLGS)
    BEGIN
        -- 1. Valores por defecto (Seguridad)
        -- Apagar todas las senales activas en ALTO
        clear &lt;= '0'; 
        Lpc &lt;= '0'; 
        Ipc &lt;= '0'; 
        SelDir &lt;= '0';
        LH &lt;= '0'; 
        LL &lt;= '0'; 
        Lri &lt;= '0'; 
        wr &lt;= '0';
        SalAlu &lt;= '0'; 
        LF &lt;= '0'; 
        Fin &lt;= '0';
        
        -- Senales de Memoria (Adaptadas al circuito MUXPCHL)
        oe &lt;= '0'; 
        we &lt;= '0'; 
        
        -- Buses de control
        SelRegW &lt;= "000"; 
        SelRegRA &lt;= "000"; 
        SelRegRB &lt;= "000"; 
        ope &lt;= "000";
        
        estado_siguiente &lt;= estado_actual; -- Por defecto, retener estado

        -- 2. Decodificacion de Maquina de Estados
        CASE estado_actual IS
        
            WHEN S00_RESET =&gt;
                clear  &lt;= '1';
                estado_siguiente &lt;= S01_FETCH0;

            WHEN S01_FETCH0 =&gt;
                oe &lt;= '1'; -- Activamos lectura de memoria
                Lri  &lt;= '1'; -- Cargamos instruccion
                estado_siguiente &lt;= S02_FETCH1;

            WHEN S02_FETCH1 =&gt;
                Ipc &lt;= '1';
                -- === DECODIFICADOR CENTRAL ===
                CASE CO IS
                    WHEN x"70" =&gt; estado_siguiente &lt;= S03_LOAD0_STORE0;
                    WHEN x"71" =&gt; estado_siguiente &lt;= S03_LOAD0_STORE0;
                    WHEN x"40" =&gt; estado_siguiente &lt;= S15_NOT0;
                    WHEN x"41" =&gt; estado_siguiente &lt;= S16_AND0;
                    WHEN x"42" =&gt; estado_siguiente &lt;= S17_DEC0;
                    WHEN x"43" =&gt; estado_siguiente &lt;= S18_INC0;
                    WHEN x"44" =&gt; estado_siguiente &lt;= S19_SUB0;
                    WHEN x"45" =&gt; estado_siguiente &lt;= S09_ADD0;
                    WHEN x"46" =&gt; estado_siguiente &lt;= S10_MOV0;
                    WHEN x"47" =&gt; estado_siguiente &lt;= S12_MOVI0;
                    WHEN x"80" =&gt; estado_siguiente &lt;= S03_LOAD0_STORE0;
                    WHEN x"81" =&gt; estado_siguiente &lt;= S03_LOAD0_STORE0;
                    WHEN x"82" =&gt; estado_siguiente &lt;= S03_LOAD0_STORE0;
                    WHEN x"83" =&gt; estado_siguiente &lt;= S03_LOAD0_STORE0;
                    WHEN x"FF" =&gt; estado_siguiente &lt;= S11_FIN0;
                    WHEN OTHERS =&gt; estado_siguiente &lt;= S01_FETCH0;
                END CASE;

            -- === ESTADOS COMUNES ===
            WHEN S03_LOAD0_STORE0 =&gt;
                oe &lt;= '1'; 
                LL &lt;= '1';
                estado_siguiente &lt;= S04_LOAD1_STORE1;
                
            WHEN S04_LOAD1_STORE1 =&gt;
                Ipc &lt;= '1';
                estado_siguiente &lt;= S05_LOAD2_STORE2;
                
            WHEN S05_LOAD2_STORE2 =&gt;
                oe &lt;= '1'; 
                LH &lt;= '1';
                estado_siguiente &lt;= S06_LOAD3_STORE3;
                
            WHEN S06_LOAD3_STORE3 =&gt;
                Ipc &lt;= '1';
                IF CO = x"70" THEN
                    estado_siguiente &lt;= S07_LOAD4;
                ELSIF CO = x"71" THEN
                    estado_siguiente &lt;= S08_STORE5;
                ELSE
                    estado_siguiente &lt;= S14_JMP_COND;
                END IF;

            -- === EJECUCION DE ACCESO A MEMORIA ===
            
            -- LOAD (70h)
            WHEN S07_LOAD4 =&gt;
                SelDir &lt;= '1'; -- MUX envia dirL a la memoria
                oe &lt;= '1';     -- Leemos de la direccion dirL
                SelRegW &lt;= "001";
                wr &lt;= '1';
                estado_siguiente &lt;= S01_FETCH0;
                
            -- STORE (71h)
            WHEN S08_STORE5 =&gt;
                SelDir &lt;= '1'; -- MUX envia dirL a la memoria
                we &lt;= '1';     -- Habilitamos escritura (Write Enable)
                SelRegRA &lt;= "001";
                ope &lt;= "000";
                SalAlu &lt;= '1'; -- El dato de R1 fluye al BusDatos
                estado_siguiente &lt;= S01_FETCH0;
                
            -- ADD (45h)
            WHEN S09_ADD0 =&gt;
                SelRegRA &lt;= "000"; 
                SelRegRB &lt;= "001"; 
                SelRegW &lt;= "001";
                ope &lt;= "101"; 
                SalAlu &lt;= '1'; 
                LF &lt;= '1'; 
                wr &lt;= '1';
                estado_siguiente &lt;= S01_FETCH0;
                
            -- MOV (46h)
            WHEN S10_MOV0 =&gt;
                SelRegRA &lt;= "001"; 
                SelRegW &lt;= "000"; 
                ope &lt;= "000";
                SalAlu &lt;= '1'; 
                wr &lt;= '1';
                estado_siguiente &lt;= S01_FETCH0;
                
            -- FIN (FFh)
            WHEN S11_FIN0 =&gt;
                Fin &lt;= '1';
                estado_siguiente &lt;= S11_FIN0;
                
            -- MOVI (47h)
            WHEN S12_MOVI0 =&gt;
                oe &lt;= '1'; 
                SelRegW &lt;= "001"; 
                wr &lt;= '1';
                estado_siguiente &lt;= S13_MOVI1;
                
            WHEN S13_MOVI1 =&gt;
                Ipc &lt;= '1';
                estado_siguiente &lt;= S01_FETCH0;

            -- SALTOS
            -- INTEGRACION: Las variables FZ, FC y FS utilizadas aqui ahora
            -- hacen referencia a los bits especificos de FLGS gracias a los ALIAS.
            WHEN S14_JMP_COND =&gt;
                IF (CO = x"80") OR 
                   (CO = x"81" AND FZ = '1') OR 
                   (CO = x"82" AND FC = '1') OR 
                   (CO = x"83" AND FS = '1') THEN
                    Lpc &lt;= '1'; -- El PC se recarga con los 16 bits de HL
                END IF;
                estado_siguiente &lt;= S01_FETCH0;

            -- ALU (Resto de operaciones)
            WHEN S15_NOT0 =&gt;
                SelRegRA &lt;= "001"; 
                SelRegW &lt;= "001";
                ope &lt;= "011"; 
                SalAlu &lt;= '1'; 
                LF &lt;= '1'; 
                wr &lt;= '1';
                estado_siguiente &lt;= S01_FETCH0;
                
            WHEN S16_AND0 =&gt;
                SelRegRA &lt;= "000"; 
                SelRegRB &lt;= "001"; 
                SelRegW &lt;= "001";
                ope &lt;= "010"; 
                SalAlu &lt;= '1'; 
                LF &lt;= '1'; 
                wr &lt;= '1';
                estado_siguiente &lt;= S01_FETCH0;
                
            WHEN S17_DEC0 =&gt;
                SelRegRA &lt;= "001"; 
                SelRegW &lt;= "001";
                ope &lt;= "100"; 
                SalAlu &lt;= '1'; 
                LF &lt;= '1'; 
                wr &lt;= '1';
                estado_siguiente &lt;= S01_FETCH0;
                
            WHEN S18_INC0 =&gt;
                SelRegRA &lt;= "001"; 
                SelRegW &lt;= "001";
                ope &lt;= "111"; 
                SalAlu &lt;= '1'; 
                LF &lt;= '1'; 
                wr &lt;= '1';
                estado_siguiente &lt;= S01_FETCH0;
                
            WHEN S19_SUB0 =&gt;
                SelRegRA &lt;= "000"; 
                SelRegRB &lt;= "001"; 
                SelRegW &lt;= "001";
                ope &lt;= "110"; 
                SalAlu &lt;= '1'; 
                LF &lt;= '1'; 
                wr &lt;= '1';
                estado_siguiente &lt;= S01_FETCH0;

            WHEN OTHERS =&gt;
                estado_siguiente &lt;= S01_FETCH0;
                
        END CASE;
    END PROCESS;
END Behavioral;</vhdl>
</project>
