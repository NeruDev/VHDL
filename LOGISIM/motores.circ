  <vhdl name="control_bombas_motores">library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity control_bombas_motores is
    Port (
        -- Entradas individuales de sensores de sobrecalentamiento
        S4    : in  STD_LOGIC; -- Mayor prioridad
        S3    : in  STD_LOGIC;
        S2    : in  STD_LOGIC;
        S1    : in  STD_LOGIC; -- Menor prioridad

        -- Bits individuales de control energético
        ctrl1 : in  STD_LOGIC; -- Bit MSB
        ctrl0 : in  STD_LOGIC; -- Bit LSB

        -- Salidas individuales hacia las bombas
        B4    : out STD_LOGIC;
        B3    : out STD_LOGIC;
        B2    : out STD_LOGIC;
        B1    : out STD_LOGIC
    );
end control_bombas_motores;

architecture una of control_bombas_motores is
begin
    process(S4, S3, S2, S1, ctrl1, ctrl0)
        variable S_vec        : STD_LOGIC_VECTOR(3 downto 0);
        variable ctrl_vec     : STD_LOGIC_VECTOR(1 downto 0);
        variable max_pumps    : integer range 1 to 4;
        variable active_count : integer range 0 to 4;
        variable B_vec        : STD_LOGIC_VECTOR(3 downto 0);
    begin
        -- Concatenación de pines individuales a vectores internos
        S_vec    := S4 &amp; S3 &amp; S2 &amp; S1;
        ctrl_vec := ctrl1 &amp; ctrl0;

        -- Asignación directa del valor binario de control a la cantidad de bombas
        case ctrl_vec is
            when "01"   =&gt; max_pumps := 1; -- 01 binario -&gt; Máximo 1 bomba
            when "10"   =&gt; max_pumps := 2; -- 10 binario -&gt; Máximo 2 bombas
            when "11"   =&gt; max_pumps := 3; -- 11 binario -&gt; Máximo 3 bombas
            when "00"   =&gt; max_pumps := 4; -- 00 representa la capacidad máxima (4 bombas)
            when others =&gt; max_pumps := 1;
        end case;

        -- Inicializar salidas y contador
        B_vec        := "0000";
        active_count := 0;

        -- Evaluación secuencial por orden de prioridad (de S4 a S1)
        for i in 3 downto 0 loop
            if S_vec(i) = '1' and active_count &lt; max_pumps then
                B_vec(i) := '1';
                active_count := active_count + 1;
            end if;
        end loop;

        -- Asignación a las salidas individuales
        B4 &lt;= B_vec(3);
        B3 &lt;= B_vec(2);
        B2 &lt;= B_vec(1);
        B1 &lt;= B_vec(0);

    end process;
end una;</vhdl>
