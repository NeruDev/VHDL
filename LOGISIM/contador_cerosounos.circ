  <vhdl name="cuenta_unos_o_ceros">LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

ENTITY cuenta_unos_o_ceros IS
  PORT(
        a, b, c, d, e, f, g : IN  std_logic; -- 7 entradas (a: LSB, g: MSB)
        cantidad            : OUT std_logic_vector(6 DOWNTO 0); -- Display 1 (Conteo)
        tipo                : OUT std_logic_vector(6 DOWNTO 0)  -- Display 2 ('0' o '1')
  );  
END ENTITY cuenta_unos_o_ceros;

ARCHITECTURE una OF cuenta_unos_o_ceros IS

    -- Función para convertir un entero (0-7) al patrón de un display de 7 segmentos (g f e d c b a)
    FUNCTION decodificar_7seg(num : INTEGER) RETURN std_logic_vector IS
    BEGIN
        CASE num IS
            WHEN 0 =&gt; RETURN "0111111"; -- Muestra '0'
            WHEN 1 =&gt; RETURN "0000110"; -- Muestra '1'
            WHEN 2 =&gt; RETURN "1011011"; -- Muestra '2'
            WHEN 3 =&gt; RETURN "1001111"; -- Muestra '3'
            WHEN 4 =&gt; RETURN "1100110"; -- Muestra '4'
            WHEN 5 =&gt; RETURN "1101101"; -- Muestra '5'
            WHEN 6 =&gt; RETURN "1111101"; -- Muestra '6'
            WHEN 7 =&gt; RETURN "0000111"; -- Muestra '7'
            WHEN OTHERS =&gt; RETURN "0000000";
        END CASE;
    END FUNCTION;

BEGIN

    PROCESS(a, b, c, d, e, f, g) IS
        VARIABLE numero      : std_logic_vector(6 DOWNTO 0);
        VARIABLE unos, ceros : INTEGER RANGE 0 TO 7; 
        VARIABLE valor_mayor : INTEGER RANGE 0 TO 7;
    BEGIN
    
        ceros := 0;
        unos  := 0;
        
        -- Concatenación de las 7 entradas
        numero := g &amp; f &amp; e &amp; d &amp; c &amp; b &amp; a;
        
        FOR i IN 0 TO 6 LOOP
            IF numero(i) = '0' THEN
                ceros := ceros + 1; 
            ELSE 
                unos := unos + 1; 
            END IF;
        END LOOP;

        IF ceros &gt; unos THEN
            valor_mayor := ceros;
            tipo        &lt;= decodificar_7seg(0); -- Muestra el símbolo '0'
        ELSE 
            valor_mayor := unos;
            tipo        &lt;= decodificar_7seg(1); -- Muestra el símbolo '1'
        END IF;
        
        cantidad &lt;= decodificar_7seg(valor_mayor);
        
    END PROCESS;

END ARCHITECTURE una;</vhdl>
