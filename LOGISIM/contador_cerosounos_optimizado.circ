  <vhdl name="cuenta_unos_o_ceros">LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY cuenta_unos_o_ceros IS
  PORT(
        a, b, c, d, e, f, g : IN  std_logic;
        cantidad            : OUT std_logic_vector(6 DOWNTO 0); -- Display 1 (Conteo mayoritario)
        tipo                : OUT std_logic_vector(6 DOWNTO 0)  -- Display 2 ('0' o '1')
  );  
END ENTITY cuenta_unos_o_ceros;

ARCHITECTURE optimizada OF cuenta_unos_o_ceros IS
BEGIN

    PROCESS(a, b, c, d, e, f, g) IS
        VARIABLE entradas : std_logic_vector(6 DOWNTO 0);
        VARIABLE unos     : INTEGER RANGE 0 TO 7;
    BEGIN
        entradas := g &amp; f &amp; e &amp; d &amp; c &amp; b &amp; a;
        unos     := 0;
        
        -- Conteo único de unos (Popcount)
        FOR i IN 0 TO 6 LOOP
            IF entradas(i) = '1' THEN
                unos := unos + 1;
            END IF;
        END LOOP;

        -- 1. Determinar tipo (Mayoría)
        IF unos &gt;= 4 THEN
            tipo &lt;= "0000110"; -- Muestra '1' en display
        ELSE
            tipo &lt;= "0111111"; -- Muestra '0' en display
        END IF;

        -- 2. Determinar cantidad aprovechando simetría
        CASE unos IS
            WHEN 0 | 7  =&gt; cantidad &lt;= "0000111"; -- Muestra '7'
            WHEN 1 | 6  =&gt; cantidad &lt;= "1111101"; -- Muestra '6'
            WHEN 2 | 5  =&gt; cantidad &lt;= "1101101"; -- Muestra '5'
            WHEN OTHERS =&gt; cantidad &lt;= "1100110"; -- Muestra '4' (Casos 3 y 4)
        END CASE;
        
    END PROCESS;

END ARCHITECTURE optimizada;</vhdl>
