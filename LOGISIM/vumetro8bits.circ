  <vhdl name="vumetro_8bits">LIBRARY ieee;&#13;
USE ieee.std_logic_1164.all;&#13;
USE ieee.numeric_std.all;
&#13;
ENTITY vumetro_8bits IS&#13;
  PORT (&#13;
       ent   : IN  STD_LOGIC_VECTOR(7 DOWNTO 0); 
       sal   : OUT STD_LOGIC_VECTOR(7 DOWNTO 0)  
    );&#13;
END ENTITY vumetro_8bits;&#13;
&#13;
ARCHITECTURE una OF vumetro_8bits IS&#13;
&#13;
BEGIN&#13;
&#13;
	PROCESS(ent) IS 
		VARIABLE entrada : INTEGER RANGE 0 TO 255;
	BEGIN

	entrada := to_integer(unsigned(ent));

	if entrada = 0 then
		sal &lt;= X"00";
	elsif entrada &lt;= 32 then
		sal &lt;= X"01";
	elsif entrada &lt;= 64 then
		sal &lt;= X"03";
	elsif entrada &lt;= 96 then
		sal &lt;= X"07";
	elsif entrada &lt;= 128 then
		sal &lt;= X"0F";			  
	elsif entrada &lt;= 160 then
		sal &lt;= X"1F";
	elsif entrada &lt;= 192 then
		sal &lt;= X"3F";
	elsif entrada &lt;= 224 then
		sal &lt;= X"7F";
	else 
		sal &lt;= X"FF";
		
	end if;
			
	END PROCESS;

END ARCHITECTURE una;&#13;

</vhdl>
